# Leave unset for local `npm run dev`; Vite proxies API calls to port 8000.
# For a separately hosted API, uncomment and use its full origin (no trailing slash).
# VITE_API_BASE_URL=https://prahari.example.internal

# Used only by `npm run dev` to proxy /api and /health requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Dashboard polling interval in milliseconds (minimum 1000, maximum 300000).
VITE_DASHBOARD_REFRESH_MS=5000
